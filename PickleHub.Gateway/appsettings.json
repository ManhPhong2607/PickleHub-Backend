        "AuthorizationPolicy": "admin-only"
      },
      "review-admin-direct-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/admin/reviews",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "review-public-get-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/reviews/product/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "review-user-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/reviews/{**catch-all}"
        }
      },
      "posts-public-route": {
        "ClusterId": "blog-cluster",
        "Match": {
          "Path": "/posts/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "posts-root-route": {
        "ClusterId": "blog-cluster",
        "Match": {
          "Path": "/posts",
          "Methods": [ "GET" ]
        }
      },
      "post-categories-public-route": {
        "ClusterId": "blog-cluster",
        "Match": {
          "Path": "/post-categories/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "post-categories-root-route": {
        "ClusterId": "blog-cluster",
        "Match": {
          "Path": "/post-categories",
          "Methods": [ "GET" ]
        }
      },
      "post-categories-admin-route": {
        "ClusterId": "blog-cluster",
        "Match": {
          "Path": "/post-categories/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "post-categories-admin-root-route": {
        "ClusterId": "blog-cluster",
        "Match": {
          "Path": "/post-categories",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "admin-posts-route": {
        "ClusterId": "blog-cluster",
        "Match": {
          "Path": "/admin/posts/{**catch-all}"
        },
        "AuthorizationPolicy": "admin-only"
      },
      "admin-posts-root-route": {
        "ClusterId": "blog-cluster",
        "Match": {
          "Path": "/admin/posts"
        },
        "AuthorizationPolicy": "admin-only"
      }
    },
    "Clusters": {
      "authen-cluster": {
        "Destinations": {
          "authen-service": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-service": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "customer-service": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "system-cluster": {
        "Destinations": {
          "system-service": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-service": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "auditlog-cluster": {
        "Destinations": {
          "auditlog-service": {
            "Address": "http://localhost:5006"
          }
        }
      },
      "cartorder-cluster": {
        "Destinations": {
