{
  "Jwt": {
    "SecretKey": "",
    "Issuer": "picklehub"
  },
  "ReverseProxy": {
    "Routes": {
      "authen-public-route": {
        "ClusterId": "authen-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}",
          "Methods": [ "POST", "GET" ]
        }
      },
      "authen-change-password-route": {
        "ClusterId": "authen-cluster",
        "Match": {
          "Path": "/auth/change-password",
          "Methods": [ "PATCH" ]
        },
        "AuthorizationPolicy": "authenticated"
      },
      "catalog-public-get-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/products/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "catalog-admin-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/admin/products/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "catalog-write-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/products/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "catalog-categories-public-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/categories",
          "Methods": [ "GET" ]
        }
      },
      "catalog-categories-write-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/categories/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "catalog-brands-public-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/brands",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "catalog-brands-write-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/brands/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "catalog-promotions-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/admin/promotions/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "catalog-promotions-public-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/promotions/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "customer-me-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/customers/me",
          "Methods": [ "GET", "PUT" ]
        },
        "AuthorizationPolicy": "authenticated"
      },
      "customer-me-sub-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/customers/me/{**catch-all}",
          "Methods": [ "GET", "PUT", "POST", "PATCH", "DELETE" ]
        },
        "AuthorizationPolicy": "authenticated"
      },
      "customer-admin-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/customers/{**catch-all}",
          "Methods": [ "GET", "PATCH" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "loyalty-tiers-public-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/loyalty-tiers",
          "Methods": [ "GET" ]
        }
      },
      "loyalty-tiers-admin-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/loyalty-tiers/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "system-announcement-public-route": {
        "ClusterId": "system-cluster",
        "Match": {
          "Path": "/system/announcements/active",
          "Methods": [ "GET" ]
        }
      },
      "system-config-read-route": {
        "ClusterId": "system-cluster",
        "Match": {
          "Path": "/system/configs/{key}",
          "Methods": [ "GET" ]
        }
      },
      "system-admin-route": {
        "ClusterId": "system-cluster",
        "Match": {
          "Path": "/system/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "inventory-public-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/public/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "inventory-check-stock-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/variants/{variantId:guid}/check",
          "Methods": [ "GET" ]
        }
      },
      "inventory-admin-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "auditlog-admin-route": {
        "ClusterId": "auditlog-cluster",
        "Match": {
          "Path": "/audit-logs/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "admin-only"
      },
      "cartorder-cart-route": {
        "ClusterId": "cartorder-cluster",
        "Match": {
          "Path": "/cart/{**catch-all}"
        }
      },
      "cartorder-orders-user-route": {
        "ClusterId": "cartorder-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },
      "cartorder-orders-admin-route": {
        "ClusterId": "cartorder-cluster",
        "Match": {
          "Path": "/admin/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "admin-only"
      },
      "payment-user-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      },
      "notification-user-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        }
      },
      "notification-hub-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/hubs/notifications/{**catch-all}"
        }
      },
      "review-admin-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/admin/reviews/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
