# ==============================================================================
# PICKLEHUB PRODUCTION / DOCKER ENVIRONMENT CONFIGURATION
# ==============================================================================

# ─── DATABASE CONFIGURATION (POSTGRESQL) ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PickleHubSecurePass123!
POSTGRES_PORT=5432
DB_HOST=postgres

# Individual Service Database Connection Strings
# Format: Host=postgres;Port=5432;Database=<DbName>;Username=postgres;Password=<Password>
AUTHEN_DB_CONN=Host=postgres;Port=5432;Database=picklehub_authen;Username=postgres;Password=PickleHubSecurePass123!
CATALOG_DB_CONN=Host=postgres;Port=5432;Database=picklehub_catalog;Username=postgres;Password=PickleHubSecurePass123!
CUSTOMER_DB_CONN=Host=postgres;Port=5432;Database=picklehub_customer;Username=postgres;Password=PickleHubSecurePass123!;Include Error Detail=true
SYSTEM_DB_CONN=Host=postgres;Port=5432;Database=picklehub_system;Username=postgres;Password=PickleHubSecurePass123!
INVENTORY_DB_CONN=Host=postgres;Port=5432;Database=picklehub_inventory;Username=postgres;Password=PickleHubSecurePass123!
AUDITLOG_DB_CONN=Host=postgres;Port=5432;Database=picklehub_auditlog;Username=postgres;Password=PickleHubSecurePass123!
CARTORDER_DB_CONN=Host=postgres;Port=5432;Database=picklehub_cartorder;Username=postgres;Password=PickleHubSecurePass123!
PAYMENT_DB_CONN=Host=postgres;Port=5432;Database=picklehub_payment;Username=postgres;Password=PickleHubSecurePass123!
NOTIFICATION_DB_CONN=Host=postgres;Port=5432;Database=picklehub_notification;Username=postgres;Password=PickleHubSecurePass123!
REVIEW_DB_CONN=Host=postgres;Port=5432;Database=picklehub_review;Username=postgres;Password=PickleHubSecurePass123!
BLOG_DB_CONN=Host=postgres;Port=5432;Database=picklehub_blog;Username=postgres;Password=PickleHubSecurePass123!

# ─── MESSAGE BROKER (RABBITMQ) & CACHE (REDIS) ───────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_HOST=redis
REDIS_PORT=6379

# ─── SECURITY & AUTHENTICATION ────────────────────────────────────────────────
# Minimum 32 characters for HMAC-SHA256 JWT Secret
JWT_SECRET_KEY=PickleHub_Super_Secret_Key_Production_2026_Minimum_32_Characters!
JWT_ISSUER=picklehub
INTERNAL_API_KEY=PickleHub_Internal_Secret_Service_Communication_Key_2026

# Admin Seed Account
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=AdminPassword123!

# ─── CLOUDINARY (MEDIA UPLOADS) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── PAYMENT GATEWAYS (OPTIONAL / SANDBOX) ────────────────────────────────────
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ─── FRONTEND & DOMAIN CONFIGURATION ──────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=http://localhost:5105
FRONTEND_PORT=3000
GATEWAY_PORT=5105
